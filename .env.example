# Development-only credentials; never use these outside local compose.
POSTGRES_USER=shadowsolve_dev
POSTGRES_PASSWORD=shadowsolve_dev
POSTGRES_DB=shadowsolve
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgres://shadowsolve_dev:shadowsolve_dev@postgres:5432/shadowsolve
SOLVER_HOST_PORT=8080
DASHBOARD_HOST_PORT=5173
# Optional compatible model artifact; empty uses the static fallback.
MODEL_ARTIFACT_HOST_PATH=./models
SHADOWSOLVE_MODEL_PATH=/models/model.json
# Optional strict protocol policy JSON; blank retains generic local fixture mode.
SHADOWSOLVE_PROTOCOL_POLICY_PATH=
# Dashboard defaults to process-local live projection; fixture is explicit only.
SHADOWSOLVE_DASHBOARD_MODE=live
# Optional read-only ingestion; unset keeps local fixture/default compatibility.
SHADOWSOLVE_INGESTION_ENABLED=false
SHADOWSOLVE_RPC_URL=
SHADOWSOLVE_NETWORK=ethereum-mainnet
SHADOWSOLVE_START_BLOCK=0
SHADOWSOLVE_FINALITY_DEPTH=12
SHADOWSOLVE_POLL_SECONDS=5
SHADOWSOLVE_MAX_AGE_SECONDS=60
SHADOWSOLVE_INGESTION_POOLS=
